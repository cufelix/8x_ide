# Copy to ~/.config/meanwhile.env or export in your shell.
# Hooks inherit environment from the Cursor process.

# OpenRouter — proposes the one question when the built-in ones do not fit
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# MEANWHILE_MODEL=openai/gpt-4.1-mini
# MEANWHILE_VOICE=1   # record a spoken intro (off by default)

# ElevenLabs — spoken intro, only with MEANWHILE_VOICE=1
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional live YouTube Data API (otherwise yt-dlp browser-like search → curated)
# YOUTUBE_API_KEY=
# MEANWHILE_DISABLE_YTDLP=1
# MEANWHILE_DISABLE_BROWSER_SEARCH=1
